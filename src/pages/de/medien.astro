---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaPage from '../../components/pages/MediaPage.astro';
import { getEntry } from 'astro:content';
const page = await getEntry('pages', 'de/media');
if (!page) throw new Error('Missing content/pages/de/media.md');
---

<BaseLayout title={`${page.data.title} · Eirik Falk, Tenor`} description={page.data.description}>
  <MediaPage locale="de" />
</BaseLayout>
