---
interface Props {
  title: string;
  tagline?: string;
}
const { title, tagline } = Astro.props;
---

<header class="page-header">
  <div class="wrap">
    <h1 class="page-header__title">{title}</h1>
    {tagline && <p class="page-header__tagline">{tagline}</p>}
  </div>
</header>

<style>
  .page-header {
    padding-block: clamp(2.5rem, 6vh, 5rem) var(--space-l);
  }
  .page-header__title {
    font-size: var(--step-5);
    line-height: 0.95;
  }
  .page-header__tagline {
    margin-top: var(--space-m);
    font-size: var(--step-1);
    max-width: 34ch;
    text-wrap: pretty;
    color: var(--c-soil-soft);
  }
</style>
