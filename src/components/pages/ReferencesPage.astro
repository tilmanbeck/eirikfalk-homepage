---
import { getCollection, getEntry } from 'astro:content';
import PageHeader from '../PageHeader.astro';
import { useTranslations, pick, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const page = await getEntry('pages', `${locale}/references`);
if (!page) throw new Error(`Missing content/pages/${locale}/references.md`);

const genres = ['Oratorium', 'Kantate', 'Oper', 'Lied', 'Sonstiges'] as const;
const genreLabel: Record<(typeof genres)[number], { de: string; en: string }> = {
  Oratorium: { de: 'Oratorium', en: 'Oratorio' },
  Kantate: { de: 'Kantate', en: 'Cantata' },
  Oper: { de: 'Oper', en: 'Opera' },
  Lied: { de: 'Lied', en: 'Lied' },
  Sonstiges: { de: 'Sonstiges', en: 'Other' },
};

const refs = (await getCollection('references')).sort((a, b) => b.data.year - a.data.year);
const rep = (await getCollection('repertoire')).sort((a, b) => a.data.composer.localeCompare(b.data.composer, 'de'));
const byGenre = <T extends { data: { genre: string } }>(list: T[]) =>
  genres.map((g) => ({ g, items: list.filter((x) => x.data.genre === g) })).filter((x) => x.items.length > 0);
const refGroups = byGenre(refs);
const repGroups = byGenre(rep);
const anyPlaceholder = refs.some((r) => r.data.placeholder) || rep.some((r) => r.data.placeholder);

const singing = (await getCollection('testimonials', ({ data }) => data.context === 'singing')).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
const teaching = (await getCollection('testimonials', ({ data }) => data.context === 'teaching'));
---

<PageHeader title={page.data.title} tagline={page.data.tagline} />

<div class="wrap">
  <nav class="jump small" aria-label={locale === 'de' ? 'Abschnitte' : 'Sections'}>
    <a class="link link--quiet" href="#engagements">{t('references.engagements')}</a>
    <a class="link link--quiet" href="#repertoire">{t('references.repertoire')}</a>
    <a class="link link--quiet" href="#stimmen">{t('references.voices')}</a>
  </nav>
</div>

<!-- Engagements: grouped by genre, hairline rows, year column -->
<section class="section section--tight" id="engagements">
  <div class="wrap block">
    <div class="block__head reveal">
      <h2 class="h2">{t('references.engagements')}</h2>
      <p class="muted intro">{t('references.engagementsIntro')}</p>
      {anyPlaceholder && <p class="small note">{t('references.placeholderNote')}</p>}
    </div>
    <div class="block__body">
      {
        refGroups.map(({ g, items }, gi) => (
          <div class="group reveal" style={`--delay:${gi * 60}ms`}>
            <h3 class="group__title">{genreLabel[g][locale]}</h3>
            <ul class="rows">
              {items.map((r) => (
                <li class="row">
                  <span class="row__year">{r.data.year}</span>
                  <span class="row__main">
                    <span class="row__work">{r.data.work}</span>
                    {r.data.composer && <span class="row__composer muted">{r.data.composer}</span>}
                  </span>
                  <span class="row__meta small">
                    {r.data.role && <span>{r.data.role}</span>}
                    {r.data.ensemble && <span class="muted">{r.data.ensemble}</span>}
                    {r.data.venue && <span class="muted">{r.data.venue}</span>}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Repertoire: two-column compact list per genre on Basil -->
<section class="section section--basil" id="repertoire">
  <div class="wrap block">
    <div class="block__head reveal">
      <h2 class="h2">{t('references.repertoire')}</h2>
      <p class="intro">{t('references.repertoireIntro')}</p>
    </div>
    <div class="block__body rep">
      {
        repGroups.map(({ g, items }, gi) => (
          <div class="group group--onbasil reveal" style={`--delay:${gi * 60}ms`}>
            <h3 class="group__title">{genreLabel[g][locale]}</h3>
            <ul class="rep__list">
              {items.map((r) => (
                <li class="rep__item">
                  <span class="rep__composer small">{r.data.composer}</span>
                  <span class="rep__work">
                    {r.data.work}
                    {r.data.role && <span class="rep__role"> · {r.data.role}</span>}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Voices: singing testimonials (empty state) and teaching reviews -->
<section class="section" id="stimmen">
  <div class="wrap">
    <div class="voices">
      <div class="voices__col reveal">
        <h2 class="h2">{t('references.voices')}</h2>
        <p class="muted intro">{t('references.voicesIntro')}</p>
        {
          singing.length === 0 ? (
            <p class="voices__empty small">{t('references.voicesEmpty')}</p>
          ) : (
            <ul class="quotes">
              {singing.map((q) => (
                <li class="quote">
                  <blockquote class="quote__text display">„{pick(q.data.quote, locale)}“</blockquote>
                  <p class="quote__by small muted">
                    {q.data.author}
                    {q.data.source && `, ${q.data.source}`}
                  </p>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <div class="voices__col voices__col--teaching reveal" style="--delay:80ms">
        <h2 class="h2 h2--small">{t('references.teaching')}</h2>
        <ul class="quotes">
          {
            teaching.map((q) => (
              <li class="quote">
                <blockquote class="quote__text quote__text--small display">„{pick(q.data.quote, locale)}“</blockquote>
                <p class="quote__by small muted">{q.data.author ?? t('testimonial.note')}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .jump {
    display: flex;
    gap: var(--space-m);
    flex-wrap: wrap;
    padding-bottom: var(--space-l);
    border-bottom: 1px solid var(--c-basil-tint);
  }
  .h2 {
    font-size: var(--step-3);
    margin-bottom: var(--space-s);
  }
  .h2--small {
    font-size: var(--step-2);
  }
  .intro {
    max-width: 44ch;
    text-wrap: pretty;
  }
  .note {
    margin-top: var(--space-s);
    color: var(--c-tomato-text);
  }
  .block {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: var(--space-xl);
    align-items: start;
  }
  .block__head {
    position: sticky;
    top: 92px;
  }
  .block__body {
    display: grid;
    gap: var(--space-l);
  }
  .group__title {
    font-size: var(--step-2);
    margin-bottom: var(--space-s);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 4rem 1.3fr 1fr;
    gap: var(--space-m);
    padding-block: 0.8rem;
    border-top: 1px solid var(--c-basil-tint);
  }
  .row:last-child {
    border-bottom: 1px solid var(--c-basil-tint);
  }
  .row__year {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.2;
  }
  .row__main,
  .row__meta {
    display: grid;
    gap: 0.1rem;
  }
  .row__work {
    font-weight: 600;
  }
  .rep__list {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: var(--space-l);
  }
  .rep__item {
    break-inside: avoid;
    display: grid;
    padding-block: 0.45rem;
    border-top: 1px solid var(--c-basil-deep);
  }
  .rep__composer,
  .rep__role {
    color: var(--c-soil);
  }
  .voices {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--space-xl);
    align-items: start;
  }
  .voices__col--teaching {
    padding-left: var(--space-xl);
    border-left: 1px solid var(--c-basil-tint);
  }
  .voices__empty {
    margin-top: var(--space-m);
    padding: var(--space-m);
    border: 1px dashed var(--c-basil);
    max-width: 44ch;
  }
  .quotes {
    list-style: none;
    margin: var(--space-m) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-l);
  }
  .quote__text {
    margin: 0 0 0.5rem;
    font-size: var(--step-2);
    line-height: 1.3;
    text-wrap: pretty;
  }
  .quote__text--small {
    font-size: var(--step-1);
  }
  @media (max-width: 799px) {
    .block,
    .voices {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
    .block__head {
      position: static;
    }
    .row {
      grid-template-columns: 3.5rem 1fr;
    }
    .row__meta {
      grid-column: 2;
    }
    .rep__list {
      columns: 1;
    }
    .voices__col--teaching {
      padding-left: 0;
      border-left: 0;
      padding-top: var(--space-l);
      border-top: 1px solid var(--c-basil-tint);
    }
  }
</style>
