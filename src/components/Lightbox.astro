---
/**
 * One dialog per page. Any <a data-lightbox href="full.jpg"> opens it.
 * Keyboard: Escape closes (native dialog), focus returns to the trigger.
 */
import { useTranslations, type Locale } from '../i18n/ui';
const locale = (Astro.currentLocale ?? 'de') as Locale;
const t = useTranslations(locale);
---

<dialog class="lightbox" id="lightbox">
  <form method="dialog" class="lightbox__bar">
    <button class="lightbox__close" type="submit" aria-label={t('lightbox.close')}>×</button>
  </form>
  <figure class="lightbox__figure">
    <img class="lightbox__img" alt="" />
    <figcaption class="lightbox__caption small"></figcaption>
  </figure>
</dialog>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dlg) {
    const img = dlg.querySelector<HTMLImageElement>('.lightbox__img')!;
    const cap = dlg.querySelector<HTMLElement>('.lightbox__caption')!;
    document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        img.src = a.href;
        img.alt = a.dataset.alt ?? '';
        cap.textContent = a.dataset.caption ?? '';
        dlg.showModal();
      });
    });
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    dlg.addEventListener('close', () => {
      img.removeAttribute('src');
    });
  }
</script>

<style>
  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(96vw, 1200px);
    max-height: 96vh;
  }
  .lightbox::backdrop {
    background: rgba(84, 48, 26, 0.85);
  }
  .lightbox__bar {
    display: flex;
    justify-content: flex-end;
    margin: 0 0 0.5rem;
  }
  .lightbox__close {
    border: 0;
    background: var(--c-paper);
    color: var(--c-soil);
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    border-radius: var(--radius);
  }
  .lightbox__figure {
    margin: 0;
  }
  .lightbox__img {
    max-width: 100%;
    max-height: 82vh;
    object-fit: contain;
    display: block;
    margin: 0 auto;
    background: var(--c-paper);
  }
  .lightbox__caption {
    color: var(--c-paper);
    margin-top: 0.5rem;
    text-align: center;
  }
</style>
