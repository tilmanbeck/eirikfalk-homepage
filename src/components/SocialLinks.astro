---
/**
 * Row of profile links as small circular marks. Instagram uses the official glyph
 * from Simple Icons (build-time import, no client JS). Operabase and Muvac have no
 * public brand icons, so they get a typographic monogram in the same circle.
 */
import { siInstagram } from 'simple-icons';
import { useTranslations, site, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: cls } = Astro.props;
const t = useTranslations(locale);
---

<ul class:list={['social', cls]} aria-label={t('social.label')}>
  <li>
    <a class="social__link" href={site.instagram} rel="me noopener" target="_blank">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path fill="currentColor" d={siInstagram.path}></path>
      </svg>
      <span class="sr-only">{t('social.instagram')}</span>
    </a>
  </li>
  <li>
    <a class="social__link" href={site.operabase} rel="noopener" target="_blank">
      <span class="social__mono" aria-hidden="true">Ob</span>
      <span class="sr-only">{t('social.operabase')}</span>
    </a>
  </li>
  <li>
    <a class="social__link" href={site.muvac} rel="noopener" target="_blank">
      <span class="social__mono" aria-hidden="true">Mv</span>
      <span class="sr-only">{t('social.muvac')}</span>
    </a>
  </li>
</ul>

<style>
  .social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-xs);
  }
  .social__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--c-basil);
    border-radius: 50%;
    color: var(--c-soil);
    transition:
      background 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out);
  }
  .social__link:hover {
    background: var(--c-basil);
    border-color: var(--c-basil);
    color: var(--c-paper);
  }
  .social__mono {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1;
    letter-spacing: -0.02em;
    transform: translateY(-1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .social__link {
      transition: none;
    }
  }
</style>
