---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactPage from '../../components/pages/ContactPage.astro';
import { getEntry } from 'astro:content';
const page = await getEntry('pages', 'de/contact');
if (!page) throw new Error('Missing content/pages/de/contact.md');
---

<BaseLayout title={`${page.data.title} · Eirik Falk, Tenor`} description={page.data.description}>
  <ContactPage locale="de" />
</BaseLayout>
