---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalPage from '../../components/pages/LegalPage.astro';
import { getEntry } from 'astro:content';
const page = await getEntry('pages', 'de/imprint');
if (!page) throw new Error('Missing content/pages/de/imprint.md');
---

<BaseLayout title={`${page.data.title} · Eirik Falk, Tenor`} description={page.data.description}>
  <LegalPage locale="de" page="imprint" />
</BaseLayout>
