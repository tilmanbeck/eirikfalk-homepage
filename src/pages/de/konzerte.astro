---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConcertsPage from '../../components/pages/ConcertsPage.astro';
import { getEntry } from 'astro:content';
const page = await getEntry('pages', 'de/concerts');
if (!page) throw new Error('Missing content/pages/de/concerts.md');
---

<BaseLayout title={`${page.data.title} · Eirik Falk, Tenor`} description={page.data.description}>
  <ConcertsPage locale="de" />
</BaseLayout>
