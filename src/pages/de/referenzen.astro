---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReferencesPage from '../../components/pages/ReferencesPage.astro';
import { getEntry } from 'astro:content';
const page = await getEntry('pages', 'de/references');
if (!page) throw new Error('Missing content/pages/de/references.md');
---

<BaseLayout title={`${page.data.title} · Eirik Falk, Tenor`} description={page.data.description}>
  <ReferencesPage locale="de" />
</BaseLayout>
