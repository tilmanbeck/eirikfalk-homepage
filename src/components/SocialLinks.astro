---
/**
 * Profile links: brand mark plus name, as a quiet text row.
 * Instagram glyph from simple-icons; Operabase and Muvac marks from their own published SVGs.
 */
import { siInstagram } from 'simple-icons';
import { muvac, operabase } from '../assets/brands/marks';
import { useTranslations, site, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: cls } = Astro.props;
const t = useTranslations(locale);
---

<ul class:list={['social', cls]} aria-label={t('social.label')}>
  <li>
    <a class="social__link" href={site.instagram} rel="me noopener" target="_blank">
      <svg class="social__mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="currentColor" d={siInstagram.path}></path>
      </svg>
      <span class="social__name">Instagram</span>
      <span class="sr-only">, {t('social.opens')}</span>
    </a>
  </li>
  <li>
    <a class="social__link" href={site.operabase} rel="noopener" target="_blank">
      <svg class="social__mark" viewBox={operabase.viewBox} aria-hidden="true" focusable="false">
        <path fill="none" stroke="currentColor" stroke-width={operabase.strokeWidth} stroke-miterlimit="10" d={operabase.path}></path>
      </svg>
      <span class="social__name">Operabase</span>
      <span class="sr-only">, {t('social.opens')}</span>
    </a>
  </li>
  <li>
    <a class="social__link" href={site.muvac} rel="noopener" target="_blank">
      <svg class="social__mark" viewBox={muvac.viewBox} aria-hidden="true" focusable="false">
        <path fill="currentColor" d={muvac.path}></path>
      </svg>
      <span class="social__name">Muvac</span>
      <span class="sr-only">, {t('social.opens')}</span>
    </a>
  </li>
</ul>

<style>
  .social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-l);
  }
  .social__link {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--c-soil-soft);
    padding-block: 0.3em;
    transition: color 0.2s var(--ease-out);
  }
  .social__mark {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
  }
  .social__name {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.2s var(--ease-out);
  }
  .social__link:hover {
    color: var(--c-soil);
  }
  .social__link:hover .social__name {
    text-decoration-color: var(--c-tomato-text);
  }
  @media (prefers-reduced-motion: reduce) {
    .social__link,
    .social__name {
      transition: none;
    }
  }
</style>
