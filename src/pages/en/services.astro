---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServicesPage from '../../components/pages/ServicesPage.astro';
import { getEntry } from 'astro:content';
const page = await getEntry('pages', 'en/services');
if (!page) throw new Error('Missing content/pages/en/services.md');
---

<BaseLayout title={`${page.data.title} · Eirik Falk, Tenor`} description={page.data.description}>
  <ServicesPage locale="en" />
</BaseLayout>
